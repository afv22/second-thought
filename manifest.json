{
  "manifest_version": 2,
  "name": "Site Access Logger",
  "version": "1.3.0",
  "description": "Requires justification before accessing specified websites and logs access with timestamps",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "tabs",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": ["src/background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Site Access Logger"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": ["src/justify.html"],
  "browser_specific_settings": {
    "gecko": {
      "id": "site-access-logger@avagliano.me",
      "data_collection_permissions": {
        "required": ["browsingActivity"]
      }
    }
  }
}

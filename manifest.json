{
  "manifest_version": 2,
  "name": "Second Thought",
  "version": "1.4.1",
  "description": "Requires justification before accessing specified websites and logs access with timestamps",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "tabs",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "src/background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Second Thought"
  },
  "options_ui": {
    "page": "src/options_page/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    "src/justify_page/justify.html"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "site-access-logger@avagliano.me",
      "data_collection_permissions": {
        "required": [
          "browsingActivity"
        ]
      }
    }
  }
}
